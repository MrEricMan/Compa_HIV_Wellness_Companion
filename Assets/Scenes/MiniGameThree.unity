  m_Script: {fileID: 11500000, guid: 98a2d6c02022d6445a39b8eda38d574e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueRunnerMiniGame3
  jamiiBubbleImage: {fileID: 889144763}
  jamiiSpeakerText: {fileID: 538987443}
  jamiiBodyText: {fileID: 820057491}
  jamiiArrow: {fileID: 239846782}
  compaBubbleImage: {fileID: 1945003774}
  compaSpeakerText: {fileID: 1886427647}
  compaBodyText: {fileID: 1101529992}
  npcPanel: {fileID: 1335251128}
  compaButton: {fileID: 1938673629}
  compaRoomPanel: {fileID: 671409909}
  choicePanel: {fileID: 1518932523}
  backButton: {fileID: 1779726614}
  npcBubbleColor: {r: 0.12156863, g: 0.18039216, b: 0.2, a: 1}
  npcTextColor: {r: 0.91764706, g: 0.87058824, b: 0.78431374, a: 1}
  youBubbleColor: {r: 0.18431373, g: 0.30980393, b: 0.33333334, a: 1}
  youTextColor: {r: 0.91764706, g: 0.87058824, b: 0.78431374, a: 1}
  charsPerSecond: 45
  mapScene: APTCenterScene
  stage1Lines:
  - speaker: Jamii
    text: "One of my relatives keeps using HIV and AIDS like they mean the same thing.
      I know there\u2019s a difference, but I\u2019m not sure how to explain it.
      Do you know? Can you ask Compa?"
  compaGreeting:
  - speaker: Compa
    text: "Hey! What\u2019s on your mind?"
  options:
  - label: Protect
    isCorrect: 0
    response:
    - speaker: You
      text: How can people protect themselves from HIV?
    - speaker: Compa
      text: People can prevent HIV by using protection during sexual activity, taking
        prevention medicine called PrEP, and avoiding sharing needles or injection
        equipment.
    - speaker: You
      text: "That\u2019s a useful question, but Jamii wanted to know how HIV and
        AIDS are different. Let me ask Compa another question."
  - label: Difference
    isCorrect: 1
    response:
    - speaker: You
      text: "What\u2019s the difference between HIV and AIDS?"
    - speaker: Compa
      text: "HIV is a virus that attacks the immune system. The body\u2019s defense
        against illness. AIDS is the most advanced stage of HIV infection, when the
        immune system is badly damaged."
    - speaker: You
      text: "So having HIV doesn\u2019t automatically mean someone has AIDS?"
    - speaker: Compa
      text: Exactly. HIV treatment can prevent it from progressing to AIDS and help
        people live long, healthy lives.
    - speaker: You
      text: "Got it. I\u2019ll go tell Jamii."
  - label: Testing
    isCorrect: 0
    response:
    - speaker: You
      text: Why is HIV testing important?
    - speaker: Compa
      text: Testing helps people know their HIV status so they can get treatment
        or explore prevention options.
    - speaker: You
      text: "That\u2019s a useful question, but Jamii wanted to know how HIV and
        AIDS are different. Let me ask Compa another question."
  - label: Unknowingly
    isCorrect: 0
    response:
    - speaker: You
      text: Can someone have HIV without knowing it?
    - speaker: Compa
      text: Yes. Someone can have HIV without any noticeable symptoms. Testing is
        the only way to know for sure.
    - speaker: You
      text: "That\u2019s a useful question, but Jamii wanted to know how HIV and
        AIDS are different. Let me ask Compa another question."
  stage3Lines:
  - speaker: Jamii
    text: "Hey, you\u2019re back! What did you find out?"
  - speaker: You
    text: "HIV is the virus, and AIDS is the most advanced stage of the infection.
      Having HIV doesn\u2019t mean someone has AIDS. Treatment can prevent that progression."
  - speaker: Jamii
    text: "That makes more sense. Thanks for looking into it! Next time it comes
      up, I\u2019ll have a clearer way to explain it."
  - speaker: You
    text: Of course! By the way, are you coming to the community potluck?
  - speaker: Jamii
    text: "Wouldn\u2019t miss it. I\u2019m bringing bariis iskukaris, so come hungry.
      I keep telling myself I\u2019ll make a small batch, but that never works out."
  - speaker: You
    text: "Great, I\u2019m excited to try it!"
